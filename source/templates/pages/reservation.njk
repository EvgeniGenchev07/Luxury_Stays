{% extends "layouts/base.njk" %}
{% block content %}
    <section class="site-hero inner-page overlay parallax" data-speed="0.5" style="background-image: url(../images/building_face.webp)">
        <div class="container">
            <div class="row site-hero-inner justify-content-center align-items-center">
                <div class="col-md-10 text-center" data-aos="fade">
                    <h1 class="heading mb-3">{{ dict.index.ctaButton }}</h1>
                    <ul class="custom-breadcrumbs mb-4">
                        <li><a class="hero-home-link" href="../{{ lang }}/index.html">{{ dict.nav.home }}</a></li>
                        <li>&bullet;</li>
                        <li>{{ dict.nav.reservation }}</li>
                    </ul>
                </div>
            </div>
        </div>

        <a class="mouse smoothscroll" href="#next">
            <div class="mouse-icon">
                <span class="mouse-wheel"></span>
            </div>
        </a>
    </section>

    <section class="section" id="next">
        <div class="container-wizard">
            <div class="header">
                <h1>{{ fullName }}</h1>
                <p class="text-center">{{ dict.reservation.description }}</p>
            </div>

            <div class="form-container">
                <div class="step-progress">
                    <div class="step active" id="step1">
                        <span>1</span>
                        <span class="step-label">{{ dict.reservation.stepOneShortHeading }}</span>
                    </div>
                    <div class="step" id="step2">
                        <span>2</span>
                        <span class="step-label">{{ dict.reservation.stepTwoHeading }}</span>
                    </div>
                    <div class="step" id="step3">
                        <span>3</span>
                        <span class="step-label">{{ dict.reservation.stepThreeHeading }}</span>
                    </div>
                </div>

                <form id="reservation-form">
                    <!-- Step 1 -->
                    <div class="form-step active" id="form-step-1">
                        <h2 class="text-center step-header">{{ dict.reservation.stepOneHeading }}</h2>
                        <div class="row">
                            <div class="form-group col-md-6">
                                <label for="checkin"><i class="fas fa-calendar-alt"></i> {{ dict.reservation.labels.checkin }}</label>
                                <input class="contact-section-input form-control" id="checkin" required type="date">
                            </div>
                            <div class="form-group col-md-6">
                                <label for="checkout"><i class="fas fa-calendar-alt"></i> {{ dict.reservation.labels.checkout }}</label>
                                <input class="contact-section-input form-control" id="checkout" required type="date">
                            </div>
                        </div>
                        <div class="row" id="adults_children_row">
                            <div class="form-group col-md-6">
                                <label for="adults"><i class="fas fa-user"></i> {{ dict.reservation.labels.adults }}</label>
                                <select class="contact-section-input form-control" id="adults" required>
                                    <option value="1">{{ dict.reservation.selectOptions.adults[0] }}</option>
                                    <option value="2">{{ dict.reservation.selectOptions.adults[1] }}</option>
                                    <option value="3">{{ dict.reservation.selectOptions.adults[2] }}</option>
                                </select>
                            </div>
                            <div class="form-group col-md-6">
                                <label for="children"><i class="fas fa-child"></i> {{ dict.reservation.labels.children }}</label>
                                <select class="contact-section-input form-control" id="children" required>
                                    <option value="0">{{ dict.reservation.selectOptions.children[0] }}</option>
                                    <option value="1">{{ dict.reservation.selectOptions.children[1] }}</option>
                                    <option value="2">{{ dict.reservation.selectOptions.children[2] }}</option>
                                    <option value="3">{{ dict.reservation.selectOptions.children[3] }}</option>
                                </select>
                            </div>
                        </div>
                        <div class="child-ages-container" id="child-ages"></div>
                        <div class="btn-group justify-content-end">
                            <button class="next" id="step1-next" type="button">{{ dict.reservation.buttons.next }}</button>
                        </div>
                    </div>

                    <!-- Step 2 -->
                    <div class="form-step" id="form-step-2">
                        <h2 class="text-center step-header">{{ dict.reservation.stepTwoHeading }}</h2>
                        <div class="row">
                            <div class="form-group col-md-6">
                                <label for="firstName"><i class="fas fa-user"></i> {{ dict.reservation.labels.firstName }}</label>
                                <input class="contact-section-input form-control" id="firstName" required type="text">
                            </div>
                            <div class="form-group col-md-6">
                                <label for="lastName"><i class="fas fa-user"></i> {{ dict.reservation.labels.lastName }}</label>
                                <input class="contact-section-input form-control" id="lastName" required type="text">
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="email"><i class="fas fa-envelope"></i> {{ dict.reservation.labels.email }}</label>
                            <input class="contact-section-input form-control" id="email" required type="email">
                        </div>
                        <div class="form-group">
                            <label for="phone"><i class="fas fa-phone"></i> {{ dict.reservation.labels.phone }}</label>
                            <input class="contact-section-input form-control" id="phone" required type="tel">
                        </div>
                        <div class="form-group">
                            <label for="note"><i class="fas fa-sticky-note"></i> {{ dict.reservation.labels.note }}</label>
                            <textarea class="contact-section-input form-control" id="note" placeholder="{{ dict.reservation.labels.note }}" rows="4"></textarea>
                        </div>
                        <div class="btn-group">
                            <button class="prev" type="button">{{ dict.reservation.buttons.previous }}</button>
                            <button class="next" id="step2-next" type="button">{{ dict.reservation.buttons.next }}</button>
                        </div>
                    </div>

                    <!-- Step 3 -->
                    <div class="form-step" id="form-step-3">
                        <div class="confirmation" id="confirmation-success">
                            <i class="fas fa-check-circle"></i>
                            <h2 class="text-center step-header">{{ dict.reservation.confirmation.successTitle }}</h2>
                            <p>{{ dict.reservation.confirmation.successText1 }}</p>
                            <p>{{ dict.reservation.confirmation.successText2 }}</p>
                            <p>{{ dict.reservation.confirmation.successText3 }} <strong class="font-weight-bold">booking@luxurystays.bg</strong></p>
                        </div>

                        <div class="confirmation" id="confirmation-error" style="display: none;">
                            <i class="fas fa-exclamation-circle" style="color: #e74c3c;"></i>
                            <h2 class="text-center step-header">{{ dict.reservation.confirmation.errorTitle }}</h2>
                            <p>{{ dict.reservation.confirmation.errorText1 }}</p>
                            <p>{{ dict.reservation.confirmation.errorText2 }}</p>
                            <button class="retry-btn" id="retry-btn"><i class="fas fa-redo"></i> {{ dict.reservation.buttons.retry }}</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <!-- Date Conflict Modal -->
    <div class="modal" id="dateConflictModal">
        <div class="modal-content">
            <h3><i class="fas fa-calendar-times"></i> {{ dict.reservation.modals.dateConflictTitle }}</h3>
            <p>{{ dict.reservation.modals.dateConflictText }}</p>
            <button id="modal-ok-btn">{{ dict.reservation.buttons.ok }}</button>
        </div>
    </div>

    <!-- Loading Modal -->
    <div class="modal" id="loadingModal">
        <div class="modal-content">
            <h3>{{ dict.reservation.modals.loadingTitle }}</h3>
            <div class="loading-container">
                <div class="loading"></div>
            </div>
            <p>{{ dict.reservation.modals.loadingText }}</p>
        </div>
    </div>

    <section class="section testimonial-section bg-light">
        <div class="container">
            <div class="row justify-content-center text-center mb-5">
                <div class="col-md-7">
                    <h2 class="heading" data-aos="fade-up">{{ dict.index.peopleSay }}</h2>
                </div>
            </div>
            <div class="row">
                <div class="embla-testimonial mb-5" data-aos="fade-up" data-aos-delay="200">
                    <button class="embla-testimonial__prev embla__button embla__button--prev"><span class="slider-controls"><svg width="64px" height="64px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M15 6L9 12L15 18" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg></span></button>
                    <div class="embla-testimonial__viewport">
                        <div class="embla__container">
                            {% include "partials/testimonials.njk" %}
                        </div>
                    </div>
                    <button class="embla-testimonial__next embla__button embla__button--next"><span class="slider-controls"><svg width="64px" height="64px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M9 6L15 12L9 18" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg></span></button>
                </div>
            </div>
        </div>
    </section>

    <section class="section bg-image overlay" style="background-image: url('../images/building_face.webp');">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-12 col-md-6 text-center mb-4 mb-md-0 text-md-left" data-aos="fade-up">
                    <h2 class="text-white font-weight-bold">{{ dict.index.ctaHeading }}</h2>
                </div>
                <div class="col-12 col-md-6 text-center text-md-right" data-aos="fade-up" data-aos-delay="200">
                    <a class="btn btn-outline-white-primary py-3 text-white px-5 smoothscroll" href="#next">{{ dict.index.ctaButton }}</a>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

