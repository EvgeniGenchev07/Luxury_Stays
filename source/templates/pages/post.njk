{% extends "layouts/base.njk" %}
{% block content %}
<section class="site-hero inner-page overlay parallax" data-speed="0.5" id="post-cover-image">
  <div class="container">
    <div class="row site-hero-inner justify-content-center align-items-center">
      <div class="col-md-10 text-center" data-aos="fade">
        <h1 class="heading mb-3">{{ dict.nav.posts }}</h1>
        <ul class="custom-breadcrumbs mb-4">
          <li><a class="hero-home-link" href="../{{ lang }}/index.html">{{ dict.nav.home }}</a></li>
          <li>&bullet;</li>
          <li>{{ dict.nav.posts }}</li>
        </ul>
      </div>
    </div>
  </div>

  <a class="mouse smoothscroll" href="#next">
    <div class="mouse-icon">
      <span class="mouse-wheel"></span>
    </div>
  </a>
</section>

<!-- Blog Details Intro Starts Here -->
<section class="blog-intro">
  <div class="container">
    <div class="row">
      <div class="col-lg-10">
        <div class="blog-intro-area">
          <span class="has-line fs-6"><span></span></span>
          <h3></h3>
          <div class="blog-intro-area-bottom">
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="blog-article section-padding" id="next">
  <div class="container">
    <div class="row">
      <div class="col-lg-10">
        <div class="row">
          <div class="col-lg-2">
          </div>
          <div class="col-lg-10">
            <div class="blog-article-end">
              <h4></h4>
              <p>
              </p>
              <div class="blog-article-end-feature">
                <p>
                </p>
              </div>
              <h6></h6>
              <img alt="" class="img-fluid" src="">
              <p>
              </p>
              <h6 class="mt-lg-5"></h6>
              <img alt="" class="img-fluid" src="">
              <p>
              </p>
              <h6 class="mt-lg-5"></h6>
              <img alt="" class="img-fluid" src="">
              <p>
              </p>
              <div class="blog-article-end-feature">
                <p></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Blog Item Feature Starts Here -->
<section class="blog-item-feature">
  <div class="container">
    <div class="blog-item-feature-heading">
      <h4>{{ dict.post.recommend }}</h4>
      <a href="../{{ lang }}/posts.html">{{ dict.post.viewAll }}</a>
    </div>
    <div class="row">
      <div class="col-lg-6 col-md-6 mb-4 mb-md-0 mb-lg-0">
        <div class="blog-item">
          <div class="blog-item-image">
            <a>
              <img alt="" src="">
            </a>
          </div>
          <div class="blog-item-info">
            <span class="fs-6 has-line" ></span>
            <h5><a></a></h5>
            <div class="blog-item-info-release">
              <br>
            </div>
            <a class="btn btn-link">{{ dict.post.read }}
              <svg fill="none" height="12" viewBox="0 0 18 12" width="18" xmlns="http://www.w3.org/2000/svg">
                <path d="M12.5 1.5L17 6M17 6L12.5 10.5M17 6H1" stroke="currentColor" stroke-linecap="round"
                      stroke-linejoin="round" stroke-width="1.5"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
      <div class="col-lg-6 col-md-6">
        <div class="blog-item">
          <div class="blog-item-image">
            <a>
              <img alt="" src="">
            </a>
          </div>
          <div class="blog-item-info">
            <span class="fs-6 has-line"></span>
            <h5><a></a></h5>
            <div class="blog-item-info-release">
              <br>
            </div>
            <a class="btn btn-link">{{ dict.post.read }}
              <svg fill="none" height="12" viewBox="0 0 18 12" width="18" xmlns="http://www.w3.org/2000/svg">
                <path d="M12.5 1.5L17 6M17 6L12.5 10.5M17 6H1" stroke="currentColor" stroke-linecap="round"
                      stroke-linejoin="round" stroke-width="1.5"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<section class="section bg-image overlay" id="section-reserve-now">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-12 col-md-6 text-center mb-4 mb-md-0 text-md-left" data-aos="fade-up">
        <h2 class="text-white font-weight-bold">{{ dict.index.ctaHeading }}</h2>
      </div>
      <div class="col-12 col-md-6 text-center text-md-right" data-aos="fade-up" data-aos-delay="200">
        <a class="btn btn-outline-white-primary py-3 text-white px-5" href="../{{ lang }}/reservation.html">{{ dict.index.ctaButton }}</a>
      </div>
    </div>
  </div>
</section>

<!-- Blog Item Feature Ends Here -->
{% endblock %}
