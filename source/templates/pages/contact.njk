{% extends "layouts/base.njk" %}
{% block content %}
<section class="site-hero inner-page overlay parallax" data-speed="0.5" style="background-image: url(../images/building_face.webp)">
  <div class="container">
    <div class="row site-hero-inner justify-content-center align-items-center">
      <div class="col-md-10 text-center" data-aos="fade">
        <h1 class="heading mb-3">{{ dict.nav.contact }}</h1>
        <ul class="custom-breadcrumbs mb-4">
          <li><a class="hero-home-link" href="../{{ lang }}/index.html">{{ dict.nav.home }}</a></li>
          <li>&bullet;</li>
          <li>{{ dict.nav.contact }}</li>
        </ul>
      </div>
    </div>
  </div>

  <a class="mouse smoothscroll" href="#next">
    <div class="mouse-icon">
      <span class="mouse-wheel"></span>
    </div>
  </a>
</section>

<section class="section contact-section" id="next">
  <div class="container">
    <div class="row">
      <div class="col-md-7" data-aos="fade-up" data-aos-delay="100">

        <form class="bg-white p-md-5 p-4 mb-5 border" data-form-output="form-output-global" id="contact-form"
              method="post">
          <div class="row">
            <div class="col-md-6 mb-3">
              <input class="form-control contact-section-input" id="subject" placeholder="{{ dict.contact.subjectPlaceholder }}" required="required"
                     type="text">
            </div>
            <div class="col-md-6 mb-3">
              <input class="form-control contact-section-input " id="name" placeholder="{{ dict.contact.namePlaceholder }}" required="required"
                     type="text">
            </div>
          </div>

          <div class="row">
            <div class="col-md-12 mb-3">
              <input class="form-control contact-section-input" id="email" placeholder="{{ dict.contact.emailPlaceholder }}" required="required"
                     type="email">
            </div>
          </div>
          <div class="row mb-4">
            <div class="col-md-12 mb-3">
              <textarea class="form-control contact-section-input" cols="30" id="message"
                        name="message" placeholder="{{ dict.contact.messagePlaceholder }}" required="required" rows="8"></textarea>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <div class="g-recaptcha" data-sitekey="6LelIwYrAAAAADB96e-yjYMj62EroB7YIuJnSjzR"
                   data-size="normal"></div>
            </div>
            <div class="col-md-6 mb-3">
              <button class="send-btn font-weight-bold" type="submit">
                              <span class="svg-wrapper-1">
                                  <span class="svg-wrapper">
                              <svg
                                height="24"
                                viewBox="0 0 24 24"
                                width="24"
                                xmlns="http://www.w3.org/2000/svg"
                              >
                                  <path d="M0 0h24v24H0z" fill="none"></path>
                                  <path
                                    d="M1.946 9.315c-.522-.174-.527-.455.01-.634l19.087-6.362c.529-.176.832.12.684.638l-5.454 19.086c-.15.529-.455.547-.679.045L12 14l6-8-8 6-8.054-2.685z"
                                    fill="currentColor"
                                  ></path></svg>
                                  </span>
                              </span>
                <span class="span"> {{ dict.contact.sendButton }}</span>
              </button>
            </div>
          </div>
        </form>

      </div>
      <div class="col-md-5" data-aos="fade-up" data-aos-delay="200">
        <div class="row">
          <div class="col-md-10 ml-auto contact-info">
            <p><span class="d-block"><span class="h5 mr-3 text-primary"><svg fill="#ffba5a" width="24px" height="24px" viewBox="0 0 32 32" version="1.1" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M16.114-0.011c-6.559 0-12.114 5.587-12.114 12.204 0 6.93 6.439 14.017 10.77 18.998 0.017 0.020 0.717 0.797 1.579 0.797h0.076c0.863 0 1.558-0.777 1.575-0.797 4.064-4.672 10-12.377 10-18.998 0-6.618-4.333-12.204-11.886-12.204zM16.515 29.849c-0.035 0.035-0.086 0.074-0.131 0.107-0.046-0.032-0.096-0.072-0.133-0.107l-0.523-0.602c-4.106-4.71-9.729-11.161-9.729-17.055 0-5.532 4.632-10.205 10.114-10.205 6.829 0 9.886 5.125 9.886 10.205 0 4.474-3.192 10.416-9.485 17.657zM16.035 6.044c-3.313 0-6 2.686-6 6s2.687 6 6 6 6-2.687 6-6-2.686-6-6-6zM16.035 16.044c-2.206 0-4.046-1.838-4.046-4.044s1.794-4 4-4c2.207 0 4 1.794 4 4 0.001 2.206-1.747 4.044-3.954 4.044z"></path> </g></svg></span>{{ dict.footer.addressLabel }}:</span>
              <span> <a class="contact-info-el" href="https://maps.app.goo.gl/MjG9y5eHqBKvikp59" target="_blank">{{ dict.footer.address }}</a></span>
            </p>
            <p><span class="d-block"><span class="h5 mr-3 text-primary"><svg width="24px" height="24px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M3 5.5C3 14.0604 9.93959 21 18.5 21C18.8862 21 19.2691 20.9859 19.6483 20.9581C20.0834 20.9262 20.3009 20.9103 20.499 20.7963C20.663 20.7019 20.8185 20.5345 20.9007 20.364C21 20.1582 21 19.9181 21 19.438V16.6207C21 16.2169 21 16.015 20.9335 15.842C20.8749 15.6891 20.7795 15.553 20.6559 15.4456C20.516 15.324 20.3262 15.255 19.9468 15.117L16.74 13.9509C16.2985 13.7904 16.0777 13.7101 15.8683 13.7237C15.6836 13.7357 15.5059 13.7988 15.3549 13.9058C15.1837 14.0271 15.0629 14.2285 14.8212 14.6314L14 16C11.3501 14.7999 9.2019 12.6489 8 10L9.36863 9.17882C9.77145 8.93713 9.97286 8.81628 10.0942 8.64506C10.2012 8.49408 10.2643 8.31637 10.2763 8.1317C10.2899 7.92227 10.2096 7.70153 10.0491 7.26005L8.88299 4.05321C8.745 3.67376 8.67601 3.48403 8.55442 3.3441C8.44701 3.22049 8.31089 3.12515 8.15802 3.06645C7.98496 3 7.78308 3 7.37932 3H4.56201C4.08188 3 3.84181 3 3.63598 3.09925C3.4655 3.18146 3.29814 3.33701 3.2037 3.50103C3.08968 3.69907 3.07375 3.91662 3.04189 4.35173C3.01413 4.73086 3 5.11378 3 5.5Z" stroke="#ffba5a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg></span>{{ dict.footer.phoneLabel }}:</span> <span> <a
              class="contact-info-el" href="tel: 00359 87 613 1555">+359 87 613 1555</a></span></p>
            <p><span class="d-block"><span class="h5 mr-3 text-primary"><svg width="24px" height="24px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M4 7.00005L10.2 11.65C11.2667 12.45 12.7333 12.45 13.8 11.65L20 7" stroke="#ffba5a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> <rect x="3" y="5" width="18" height="14" rx="2" stroke="#ffba5a" stroke-width="2" stroke-linecap="round"></rect> </g></svg></span>{{ dict.footer.emailLabel }}:</span> <span> <a
              class="contact-info-el" href="mailto: booking@luxurystays.bg">booking@luxurystays.bg</a></span></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<section class="section bg-image overlay" style="background-image: url('../images/building_face.webp');">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-12 col-md-6 text-center mb-4 mb-md-0 text-md-left" data-aos="fade-up">
        <h2 class="text-white font-weight-bold">{{ dict.index.ctaHeading }}</h2>
      </div>
      <div class="col-12 col-md-6 text-center text-md-right" data-aos="fade-up" data-aos-delay="200">
        <a class="btn btn-outline-white-primary py-3 text-white px-5" href="../{{ lang }}/reservation.html">{{ dict.index.ctaButton }}</a>
      </div>
    </div>
  </div>
</section>
    <div class="snackbars" id="form-output-global"></div>

{% endblock %}
